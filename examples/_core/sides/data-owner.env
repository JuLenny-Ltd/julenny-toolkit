# _core side profile: DATA OWNER (the "Acme" role in the demos).
#
# Static, per-side parameters the shared driver reads. Sourced by _core/run.sh
# after the scenario's config. Do NOT put per-collaboration state here (that
# stays in the workdir's config.env).

JULENNY_OUR_SIDE="data-owner"

# Display labels. A scenario may override JL_OUR_LABEL / JL_PEER_LABEL in its
# scenario.env to fit a narrative (e.g. Buyer / Supplier); these are the
# defaults if it does not.
JL_OUR_LABEL="${JL_OUR_LABEL:-Acme}"
JL_PEER_LABEL="${JL_PEER_LABEL:-Beta}"
JL_ROLE_LABEL="data owner / lead"

# This side stores its FHE secret share under this filename. ASYMMETRIC by
# design - the consumer side uses a different name. Do not unify (see the
# secret-share-filenames-asymmetric memory).
JL_SECRET_SHARE_FILE="fhe_secret_key.bin"

# Platform API: how this side lists its permissions, and which
# collaboration-id field on a permission points at the PEER.
JL_PERM_VIEW="permissioned"
# Collaboration ID (XXXX-XXXX) of the peer.
JL_PEER_COLLAB_FIELD="dataConsumerCollaborationId"
JL_ROLE_DIR="lead"
