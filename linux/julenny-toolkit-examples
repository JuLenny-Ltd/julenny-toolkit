#!/usr/bin/env bash
# Copy the JuLenny FHE Toolkit example scripts out of the read-only package
# location into a folder you can run and edit.
#
# The package installs the full example tree under /usr/share, which is not
# writable and not where you want to work. This picks your side of the
# collaboration and copies just that side's scripts wherever you ask.
#
# Interactive by default. For CI or scripted installs, pass --role and --dest.

set -euo pipefail

SRC_DEFAULT="/usr/share/julenny-toolkit/examples"
SRC="${JULENNY_EXAMPLES_SRC:-$SRC_DEFAULT}"
DEST_DEFAULT="$HOME/julenny-examples"

ROLE=""
DEST=""
FORCE=false
ASSUME_YES=false

# ---------- output helpers ----------
if [[ -t 1 ]]; then
    B=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; YLW=$'\033[33m'; RED=$'\033[31m'; RST=$'\033[0m'
else
    B=""; DIM=""; GRN=""; YLW=""; RED=""; RST=""
fi
info()    { echo "${DIM}$*${RST}"; }
success() { echo "${GRN}$*${RST}"; }
warn()    { echo "${YLW}$*${RST}" >&2; }
die()     { echo "${RED}error:${RST} $*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
Usage: julenny-toolkit-examples [options]

Copies the JuLenny FHE Toolkit example scripts to a writable folder.

Options:
  --role <owner|consumer|both>  Which side of the collaboration to install.
                                  owner    = data owner   (acme/ folders)
                                  consumer = data consumer (beta/ folders)
                                  both     = everything (for single-machine tests)
  --dest <path>                 Where to copy them. Default: ~/julenny-examples
  --force                       Overwrite a non-empty destination.
  --yes                         Skip the final confirmation.
  -h, --help                    Show this help.

With no options it asks interactively.

Examples:
  julenny-toolkit-examples
  julenny-toolkit-examples --role consumer --dest /srv/julenny --yes
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --role)   ROLE="${2:-}"; shift 2 ;;
        --dest)   DEST="${2:-}"; shift 2 ;;
        --force)  FORCE=true; shift ;;
        --yes|-y) ASSUME_YES=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

[[ -d "$SRC" ]] || die "example sources not found at $SRC
Is the julenny-toolkit package installed? Set JULENNY_EXAMPLES_SRC to override."

# ---------- role ----------
if [[ -z "$ROLE" ]]; then
    echo
    echo "${B}Which side of the collaboration is this machine?${RST}"
    echo
    echo "  1) Data owner      - holds the data being queried      (acme/ scripts)"
    echo "  2) Data consumer   - triggers the run, sees the result (beta/ scripts)"
    echo "  3) Both            - single-machine testing"
    echo "  4) Cancel          - don't install the examples"
    echo
    read -r -p "Choose (1-4) [1]: " _choice
    case "${_choice:-1}" in
        1) ROLE="owner" ;;
        2) ROLE="consumer" ;;
        3) ROLE="both" ;;
        4) info "Cancelled. Nothing was copied."; exit 0 ;;
        *) die "invalid choice: ${_choice}" ;;
    esac
fi

case "$ROLE" in
    owner|consumer|both) ;;
    *) die "--role must be owner, consumer or both (got '$ROLE')" ;;
esac

# ---------- destination ----------
if [[ -z "$DEST" ]]; then
    echo
    read -r -p "Where should they go? [$DEST_DEFAULT]: " _dest
    DEST="${_dest:-$DEST_DEFAULT}"
fi

# Expand a leading ~ typed by hand (the shell does not do it for read input).
[[ "$DEST" == "~"* ]] && DEST="${HOME}${DEST#\~}"

if [[ -e "$DEST" && -n "$(ls -A "$DEST" 2>/dev/null || true)" ]] && ! $FORCE; then
    die "$DEST exists and is not empty.
Pass --force to overwrite it, or choose a different folder."
fi

# ---------- confirm ----------
if ! $ASSUME_YES; then
    echo
    echo "  role:        $ROLE"
    echo "  destination: $DEST"
    echo
    read -r -p "Proceed? [Y/n]: " _ok
    case "${_ok:-Y}" in
        [Yy]*) ;;
        *) info "Cancelled. Nothing was copied."; exit 0 ;;
    esac
fi

# ---------- copy ----------
# Copy the whole tree, then prune the side that was not asked for. Pruning
# rather than enumerating what to include means a newly added shared file is
# picked up automatically instead of being silently left behind.
mkdir -p "$DEST"
cp -R "$SRC"/. "$DEST"/
chmod -R u+w "$DEST"

# Both extensions on the side profile: it exists as a .env and a .ps1 twin.
case "$ROLE" in
    owner)
        rm -rf "$DEST"/*/beta "$DEST"/_core/main \
               "$DEST"/_core/sides/data-consumer.env "$DEST"/_core/sides/data-consumer.ps1
        ;;
    consumer)
        rm -rf "$DEST"/*/acme "$DEST"/_core/lead \
               "$DEST"/_core/sides/data-owner.env "$DEST"/_core/sides/data-owner.ps1
        ;;
esac

# Drop the Windows scripts. This machine cannot run a .ps1, and leaving them
# beside their .sh twins invites someone to try the wrong one.
find "$DEST" -name '*.ps1' -delete

find "$DEST" -name '*.sh' -exec chmod +x {} +

# ---------- next steps ----------
case "$ROLE" in
    owner)    _side_dir="acme" ;;
    consumer) _side_dir="beta" ;;
    both)     _side_dir="acme" ;;
esac

echo
success "Examples installed to $DEST"

# List what was actually copied, and give a command that can be pasted as-is.
# A "<scenario>" placeholder is not a next step; the operator should not have to
# go and work out what the options are.
_scenarios=()
for _d in "$DEST"/*/; do
    _name="$(basename "$_d")"
    [[ "$_name" == "_core" ]] && continue
    _scenarios+=("$_name")
done

echo
echo "${B}Scenarios available${RST}"
for _name in "${_scenarios[@]}"; do
    if [[ "$_name" == "joint-record-overlap" ]]; then
        echo "  $_name   (simplest: exact whole-number answers)"
    else
        echo "  $_name"
    fi
done

# Prefer joint-record-overlap for the worked example: BFV, so the answer is an
# exact integer the operator can check by hand.
_first="joint-record-overlap"
if [[ ! -d "$DEST/$_first" ]]; then
    _first="${_scenarios[0]:-<scenario>}"
fi

echo
echo "${B}To start${RST}"
echo "  cd $DEST/$_first/$_side_dir"
echo "  ./run.sh"
echo
info "run.sh is menu-driven and resumes wherever you left off. It waits when it"
info "needs the other side to act."
info "Each scenario's README.md gives its sample data and the expected answer, so"
info "you can confirm the result is correct. $DEST/README.md has the full phase breakdown."
if [[ "$ROLE" == "both" ]]; then
    echo
    info "You installed both sides. To drive them from one host, give each shell"
    info "its own workdir (export JL_WORKDIR=...); see README.md."
fi
