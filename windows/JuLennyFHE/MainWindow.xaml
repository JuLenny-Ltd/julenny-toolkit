                </StackPanel>

                <!-- WRAP UPLOAD -->
                <StackPanel x:Name="WrapEnvelopePanel" Spacing="20" Visibility="Collapsed">
                    <TextBlock Text="Wrap upload (sign for the platform)"
                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        After you produce a contribution share with one of the contribute screens
                        (Generate keypair, Keysetup share, Sum contribute, Relin contribute), use
                        this screen to wrap that .bin file into a signed .json envelope that the
                        platform's keysetup page accepts as the upload body.

                        The round number and message type come from the project's keysetup page on
                        the platform - it tells you which round it's expecting next and which kind
                        of share. Copy those values into the fields below.
                    </TextBlock>

                    <!-- Binary share to wrap -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Binary share file (.bin)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="WrapEnvelopePayloadFile" Grid.Column="0"
                                     PlaceholderText="Click Browse to pick the .bin produced by a contribute screen"
                                     IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse..."
                                    Click="OnWrapEnvelopePayloadBrowseClicked" />
                        </Grid>
                    </StackPanel>

                    <!-- Ed25519 signing secret key -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Signing secret key (.bin from Signing key screen)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="WrapEnvelopeSecretKeyFile" Grid.Column="0"
                                     PlaceholderText="Click Browse to pick signing_secret_key.bin"
                                     IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse..."
                                    Click="OnWrapEnvelopeSecretKeyBrowseClicked" />
                        </Grid>
                    </StackPanel>

                    <!-- Project metadata (from the platform's keysetup page).
                         2026-06: no company ID here anymore - the signed
                         envelope no longer carries fromCompanyId; the platform
                         derives the signer from authentication. -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Permission ID"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="WrapEnvelopePermissionId"
                                 PlaceholderText="from the URL of the platform's keysetup page" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,16,*" RowSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="Round"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox x:Name="WrapEnvelopeRound"
                                     PlaceholderText="e.g. 1"
                                     Width="80" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="Message type"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox x:Name="WrapEnvelopeMessageType"
                                      PlaceholderText="Pick or type"
                                      IsEditable="True"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="pk-share" />
                                <ComboBoxItem Content="relin-round1" />
                                <ComboBoxItem Content="relin-round1-continue" />
                                <ComboBoxItem Content="relin-round2" />
                                <ComboBoxItem Content="sum-round1" />
                                <ComboBoxItem Content="sum-round1-continue" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Output .json -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output .json (this is what you upload)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="WrapEnvelopeOutputFile" Grid.Column="0"
                                     PlaceholderText="Click Browse to pick where to save the .json"
                                     IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse..."
                                    Click="OnWrapEnvelopeOutputBrowseClicked" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="WrapEnvelopeGoButton"
                            Content="Wrap and sign"
                            Click="OnWrapEnvelopeGoClicked"
                            Style="{StaticResource AccentButtonStyle}" />

                    <Border x:Name="WrapEnvelopeResultBorder"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Visibility="Collapsed">
                        <TextBox x:Name="WrapEnvelopeResultText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 IsSpellCheckEnabled="False" />
                    </Border>
                </StackPanel>

                <!-- WRAP FINAL KEYS -->
                <StackPanel x:Name="WrapFinalKeysPanel" Spacing="20" Visibility="Collapsed">
                    <TextBlock Text="Wrap final keys (sign for the platform)"
                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        Final step of the joint keysetup. After both parties have produced
                        their three final joint keys locally and uploaded them through the
                        platform's web UI (or via the REST API), the platform emits a
                        to-sign JSON file listing each key's GCS object path and SHA-256
                        hash. Open that file here together with your signing key, and the
                        app produces a signed envelope you upload back through the platform
                        to complete the keysetup.

                        Like every other screen in this app, this step is offline. The
                        signing key never leaves this machine, and the app makes no network
                        calls.
                    </TextBlock>

                    <!-- To-sign JSON file from the web UI -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="To-sign JSON file (from the platform's finalization flow)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="WrapFinalKeysToSignFile" Grid.Column="0"
                                     PlaceholderText="Click Browse to pick the to-sign .json the web UI gave you"
                                     IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse..."
                                    Click="OnWrapFinalKeysToSignBrowseClicked" />
                        </Grid>
                    </StackPanel>

                    <!-- Ed25519 signing secret key -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Signing secret key (.bin from Signing key screen)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="WrapFinalKeysSecretKeyFile" Grid.Column="0"
                                     PlaceholderText="Click Browse to pick signing_secret_key.bin"
                                     IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse..."
                                    Click="OnWrapFinalKeysSecretKeyBrowseClicked" />
                        </Grid>
                    </StackPanel>

                    <!-- Output .json -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Output .json (signed final-keys envelope; bring this back to the web UI)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="WrapFinalKeysOutputFile" Grid.Column="0"
                                     PlaceholderText="Click Browse to pick where to save the signed envelope"
                                     IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse..."
                                    Click="OnWrapFinalKeysOutputBrowseClicked" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="WrapFinalKeysGoButton"
                            Content="Wrap and sign"
                            Click="OnWrapFinalKeysGoClicked"
                            Style="{StaticResource AccentButtonStyle}" />

                    <Border x:Name="WrapFinalKeysResultBorder"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Visibility="Collapsed">
                        <TextBox x:Name="WrapFinalKeysResultText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 IsSpellCheckEnabled="False" />
                    </Border>
                </StackPanel>

                <!-- SETTINGS -->
                <StackPanel x:Name="SettingsPanel" Spacing="20" Visibility="Collapsed">
                    <TextBlock Text="Settings"
                               Style="{StaticResource TitleLargeTextBlockStyle}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Local environment"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="SettingsStatusText"
                                       Text="(loading...)"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       TextWrapping="Wrap" />
                            <Button Content="Refresh"
                                    Click="OnSettingsRefreshClicked"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        </NavigationView>
    </Grid>
</Window>
